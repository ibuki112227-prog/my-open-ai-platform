# 1. 必要なライブラリのインストール（bitsandbytesを含む）
!pip install -q transformers accelerate torch torchvision gradio bitsandbytes

import torch
from transformers import AutoModelForCausalLM, AutoTokenizer, BitsAndBytesConfig, pipeline
import gradio as gr

# 2. Qwen3.8-27B を 4bit量子化 で読み込み
print("🤖 Qwen3.8-27B (4bit) をロード中... (少し時間がかかります)")
model_id = "Qwen/Qwen3.8-27B"

# 4bit量子化の設定（VRAMを大幅に節約しつつ賢さをキープ）
quantization_config = BitsAndBytesConfig(
    load_in_4bit=True,
    bnb_4bit_compute_dtype=torch.bfloat16,
    bnb_4bit_quant_type="nf4"
)

tokenizer = AutoTokenizer.from_pretrained(model_id)

model = AutoModelForCausalLM.from_pretrained(
    model_id,
    quantization_config=quantization_config,
    device_map="auto"
)

# パイプラインの作成
pipe = pipeline("text-generation", model=model, tokenizer=tokenizer)
print("✨ Qwen3.8-27B (4bit) のロードが完了しました！")

# 3. チャット処理の関数
def chat_with_open_ai(message, history):
    messages = []
    for user_msg, bot_msg in history:
        messages.append({"role": "user", "content": user_msg})
        messages.append({"role": "assistant", "content": bot_msg})
    
    messages.append({"role": "user", "content": message})
    
    prompt = tokenizer.apply_chat_template(
        messages, 
        tokenize=False, 
        add_generation_prompt=True
    )
    
    outputs = pipe(
        prompt, 
        max_new_tokens=512, 
        do_sample=True, 
        temperature=0.7,
        top_p=0.9
    )
    
    generated_text = outputs[0]["generated_text"]
    response = generated_text[len(prompt):].strip()
    
    return response

# 4. Gradio UIの構築
with gr.Blocks() as demo:
    gr.Markdown("# 🔥 Qwen3.8-27B (4bit) Private Platform")
    gr.Markdown("27Bクラスの超高性能AIを4bit化してプライベート環境で動かしています。制限なしの高度な対話をどうぞ！")
    
    gr.ChatInterface(
        fn=chat_with_open_ai,
        textbox=gr.Textbox(placeholder="メッセージを入力...", container=False, scale=7)
    )

# 5. 起動（パスワード認証付き：ここをご自身の好きなIDとパスワードに変更してください）
demo.launch(
    share=True, 
    debug=True, 
    theme=gr.themes.Monochrome(),
    auth=("your_username", "your_password")
)
